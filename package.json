{
  "name": "eidex",
  "private": true,
  "homepage": "https://eidex.info",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:encounters": "vitest run src/test/randomizedEncounters.test.ts",
    "test:species-table": "vitest run src/test/SpeciesTable.test.ts",
    "test:ui": "vitest --ui",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "generate-spritesheet": "tsc scripts/generate-spritesheet.ts --outDir dist/scripts --target ES2022 --module ES2022 --moduleResolution bundler && node dist/scripts/generate-spritesheet.js",
    "generate-pokemon-spritesheet": "tsc scripts/generate-pokemon-spritesheet.ts --outDir dist/scripts --target ES2022 --module ES2022 --moduleResolution bundler && node dist/scripts/generate-pokemon-spritesheet.js",
    "generate-mapsvgs": "tsc scripts/generate-map-svgs.ts --outDir dist/scripts --target ES2022 --module ES2022 --moduleResolution bundler && node dist/scripts/generate-map-svgs.js",
    "scan": "next dev & npx react-scan@latest localhost:3000"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.11.6",
    "@headlessui/react": "^2.2.7",
    "@tailwindcss/vite": "^4.1.12",
    "@types/connect-history-api-fallback": "^1.5.4",
    "@use-gesture/react": "^10.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connect-history-api-fallback": "^2.0.0",
    "idb": "^8.0.3",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.540.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^6.0.0",
    "react-hotkeys-hook": "^5.1.0",
    "react-icons": "^5.5.0",
    "react-scan": "^0.4.3",
    "react-spring": "^10.0.0",
    "react-window": "^1.8.11",
    "simplebar-react": "^3.3.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-safe-area": "^1.1.0",
    "trie-search": "^2.2.0",
    "use-sync-external-store": "^1.5.0",
    "wouter": "^3.7.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "@eslint/js": "^9.26.0",
    "@svgr/cli": "^8.1.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/nesting": "^0.0.0-insiders.565cd3e",
    "@tailwindcss/postcss": "^4.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.5.2",
    "@xmldom/xmldom": "^0.9.8",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^19.1.0-rc.2",
    "cheerio": "^1.0.0",
    "eslint": "^9.26.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.0.0-rc.1",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.1.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "postcss-import": "^16.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "rollup-plugin-visualizer": "^6.0.3",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.2"
  }
}
